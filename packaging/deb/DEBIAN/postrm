#!/bin/sh
# The image and each user's state live outside the package, so purging says
# where they are rather than reaching into anyone's home directory.
set -e

if [ "$1" = "purge" ]; then
    echo "Stored keys and sessions are per user in ~/.local/share/shipwright; remove it to clear them."
    echo "The container image is still in Docker; remove it with: docker image rm ghcr.io/abj360/shipwright"
fi

exit 0
