#!/bin/sh
# Checks the two prerequisites apt cannot install itself, then leaves.
set -e

case "$1" in
    configure) ;;
    *) exit 0 ;;
esac

command -v docker > /dev/null 2>&1 \
    || echo "W: docker is not installed; ship needs it to run the sandbox" >&2
command -v runsc > /dev/null 2>&1 \
    || echo "W: gVisor (runsc) is not installed; ship will not run without it. See https://gvisor.dev/docs/user_guide/install/" >&2

exit 0
